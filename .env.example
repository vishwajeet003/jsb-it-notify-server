RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=JSB IT Ticketing <onboarding@resend.dev>
TECH_EMAIL=tech@armoroctrading.com

# Optional: automatic Telegram notification with the PDF attached (leave blank to skip)
TELEGRAM_BOT_TOKEN=123456789:your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: automatic WhatsApp notification via CallMeBot (text summary only, no PDF; leave blank to skip)
CALLMEBOT_PHONE=15551234567
CALLMEBOT_APIKEY=123456

# Optional but recommended: shared ticket storage (Open Tickets/History visible to everyone).
# Without this, ticket submission still emails/Telegrams the tech, it just isn't saved anywhere.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Optional: override the technician close-ticket PIN (default is "2003").
# Compute a SHA-256 hex hash of your new PIN and paste it here.
TECH_PASSWORD_HASH=77459b9b941bcb4714d0c121313c900ecf30541d158eb2b9b178cdb8eca6457e
